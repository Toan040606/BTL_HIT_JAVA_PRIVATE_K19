                  </Hyperlink>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
            <Button fx:id="login_btn" mnemonicParsing="false" onAction="#handleLogin" prefHeight="31.0" prefWidth="362.0" style="-fx-background-color: #ff670f;" text="Đăng nhập" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <VBox.margin>
                  <Insets />

                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Text>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </HBox>
            <Label fx:id="username_label" prefHeight="17.0" prefWidth="83.0" text="Tài khoản:" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <TextField fx:id="txtUser" onAction="#handleLogin" prefHeight="33.0" prefWidth="362.0" style="-fx-background-color: #3d3d3d; -fx-border-color: #666666; -fx-text-fill: white;">
               <font>
                  <Font size="15.0" />
               </font>
            </TextField>
            <Label fx:id="password_label" prefHeight="17.0" prefWidth="83.0" text="Mật khẩu:" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <PasswordField fx:id="txtPass" onAction="#handleLogin" prefHeight="31.0" prefWidth="362.0" style="-fx-background-color: #3d3d3d; -fx-border-color: #666666; -fx-text-fill: white;">
               <font>
                  <Font size="15.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </PasswordField>
            <HBox alignment="CENTER" prefHeight="39.0" prefWidth="360.0" spacing="70.0">
               <children>
                  <CheckBox fx:id="remember_me" alignment="CENTER" mnemonicParsing="false" text="Nhớ lần đăng nhập này" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font size="13.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </CheckBox>
                  <Hyperlink alignment="CENTER_RIGHT" contentDisplay="RIGHT" onAction="#goForgotPassword" prefHeight="24.0" prefWidth="115.0" text="Quên mật khẩu ?" textFill="#b5b5b5">
                     <HBox.margin>
                        <Insets />

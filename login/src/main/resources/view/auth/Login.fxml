            <Button fx:id="go_register" mnemonicParsing="false" onAction="#goRegister" prefHeight="31.0" prefWidth="362.0" style="-fx-background-color: #3b3b3b;" text="Bạn chưa có tài khoản? Đăng ký" textFill="WHITE">
               <font>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.LoginController">
   <children>
      <VBox layoutX="129.0" layoutY="100.0" prefHeight="400.0" prefWidth="341.0">
         <children>
            <Label alignment="TOP_LEFT" prefHeight="54.0" prefWidth="155.0" style="-fx-font-weight: bold;" text="Đăng nhập" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font size="28.0" />
               </font>
               <VBox.margin>
                  <Insets left="100.0" />
               </VBox.margin>
            </Label>
            <Label alignment="TOP_LEFT" prefHeight="27.0" prefWidth="87.0" style="-fx-font-weight: bold;" text="Tài khoản:" textFill="WHITE">
               <font>
                  <Font size="15.0" />
               </font>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtUser" alignment="TOP_LEFT" prefHeight="33.0" prefWidth="334.0" style="-fx-background-color: #444; -fx-text-fill: white;">
               <font>
                  <Font size="15.0" />
               </font>
               <opaqueInsets>
                  <Insets top="10.0" />
               </opaqueInsets>
            </TextField>
            <Label alignment="TOP_LEFT" prefHeight="27.0" prefWidth="87.0" style="-fx-font-weight: bold;" text="Mật khẩu:" textFill="WHITE">
               <font>
                  <Font size="15.0" />
               </font>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <PasswordField fx:id="txtPass" style="-fx-background-color: #444; -fx-text-fill: white;">
               <font>
                  <Font size="15.0" />
               </font>
            </PasswordField>
            <HBox alignment="CENTER" prefHeight="27.0" prefWidth="334.0" style="-fx-text-fill: while;">
               <children>
                  <CheckBox mnemonicParsing="false" prefHeight="17.0" prefWidth="247.0" text="Nhớ lần đăng nhập này" textFill="#bababa" />
                  <Hyperlink contentDisplay="RIGHT" onAction="#goForgotPassword" prefHeight="24.0" prefWidth="112.0" text="Quên mật khẩu ?" textFill="#b5b5b5" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="37.0" prefWidth="359.0" style="-fx-background-color: #ff7a00; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Đăng nhập" textFill="WHITE">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#goRegister" prefHeight="25.0" prefWidth="341.0" style="-fx-background-color: #444;" text="Bạn chưa có tài khoản? Đăng ký" textFill="#dbdbdb">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </Button>

             <Label fx:id="lblMsg" alignment="CENTER" prefWidth="334.0">
                 <VBox.margin>
                     <Insets top="10.0" />
                 </VBox.margin>
             </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>

            </Label>
            <TextField fx:id="txtHoTen" style="-fx-background-color: #444; -fx-text-fill: white;">
               <font>
                  <Font size="15.0" />
               </font>
            </TextField>
            <Label style="-fx-font-weight: bold;" text="Tên đăng nhập:" textFill="WHITE">
               <font>
                  <Font size="15.0" />

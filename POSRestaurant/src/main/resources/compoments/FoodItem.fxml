<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox alignment="CENTER" prefHeight="40.0" prefWidth="466.0" spacing="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="root.controller.components.FoodItemController">
   <children>
      <ImageView fx:id="img" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="foodName" prefHeight="20.0" prefWidth="370.0" HBox.hgrow="ALWAYS">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Button fx:id="editFood" mnemonicParsing="false">
         <graphic>
            <FontIcon iconLiteral="far-edit" tabSize="9">
               <font>
                  <Font size="14.0" />
               </font>
            </FontIcon>
         </graphic>
      </Button>
      <Button fx:id="deleteFood" mnemonicParsing="false" prefHeight="26.0" prefWidth="26.0" text="X" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>
